# Copy to .env and fill in. Never commit .env.
# Docker Compose reads this file automatically. For a backend started from the IDE or `mvnw`,
# export the same variables in your shell or run configuration.

# --- Database (PostgreSQL + pgvector) ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=5434
DB_NAME=docmind
DB_USER=postgres
# local development only; the container is initialised with this on first start
DB_PASSWORD=postgres

# --- Security ---------------------------------------------------------------------------------
# At least 32 bytes. Generate one with:  openssl rand -base64 48
# Required outside the dev profile; in dev a random key is generated per process if unset.
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
# true whenever the app is served over HTTPS
REFRESH_COOKIE_SECURE=false
# Strict for same-site deployments; None (with REFRESH_COOKIE_SECURE=true) for cross-site frontends
REFRESH_COOKIE_SAME_SITE=Strict
# Exact origins allowed to call the API cross-origin. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=

# --- AI provider (OpenAI or an OpenAI-compatible API) ----------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Must produce 1536-dimensional embeddings (vector_store schema)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# SPRING_AI_OPENAI_BASE_URL=https://api.openai.com

# --- Server -----------------------------------------------------------------------------------
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
MAX_UPLOAD_SIZE=25MB
FRONTEND_PORT=8080
