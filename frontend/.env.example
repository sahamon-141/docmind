# Base URL of the DocMind API as seen by the browser.
# Leave empty to call the same origin (/api/v1/...). This is the default for local development,
# where Vite proxies /api to the backend, and for the Docker image, where nginx does the same.
# Set it only for a cross-origin deployment, e.g. https://api.docmind.example.com
# (the backend must then list the frontend origin in CORS_ALLOWED_ORIGINS and use
# REFRESH_COOKIE_SAME_SITE=None with REFRESH_COOKIE_SECURE=true).
VITE_API_BASE_URL=

# Development only: where the Vite dev server proxies /api requests.
DEV_API_PROXY_TARGET=http://localhost:8081
